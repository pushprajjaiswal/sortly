{
  "expo": {
    "name": "Ball Sort: Tube Master",
    "slug": "sortly",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.binarybeast.ballsort"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1530",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.binarybeast.ballsort"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3264759639979045~7856980612",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16213E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#16213E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class androidx.room.** { *; }\n-keep class * extends androidx.room.RoomDatabase { <init>(); *; }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.startup.** { *; }\n-dontwarn androidx.work.**\n-dontwarn androidx.room.**"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "adfda91f-043e-4070-97fe-7f6d80ca4920"
      }
    }
  }
}
